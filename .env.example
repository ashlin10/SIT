# Session secret for web app (generate a random 32+ character string)
WEB_APP_SESSION_SECRET=your-random-secret-key-here

# Encryption key for stored FMC credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here

# Default credentials for standalone scripts (configure_http_proxy.py, copy_dev_crt.py, etc.)
DEFAULT_HOST=10.106.239.165
DEFAULT_SSH_USERNAME=admin
DEFAULT_FTD_PASSWORD=Cisco@12
DEFAULT_FMC_PASSWORD=Cisco@123

# Optional: Users as JSON (alternative to web_app/data/users.json)
# USERS_JSON={"admin": "password123"}

# CIRCUIT API for GenAI Access (required for AI Chat feature)
# Obtain these from your Cisco CIRCUIT API portal
BRIDGE_API_CLIENT_ID=your-okta-client-id-here
BRIDGE_API_CLIENT_SECRET=your-okta-client-secret-here
BRIDGE_API_APP_KEY=your-circuit-app-key-here

# Optional: Override default API endpoints and model
# CIRCUIT_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# CIRCUIT_CHAT_BASE_URL=https://chat-ai.cisco.com
# CIRCUIT_MODEL=gpt-4.1
# CIRCUIT_API_VERSION=2025-04-01-preview

# Duo SAML SSO (required for SSO login)
# Get these values from your Duo Admin Panel after creating a Generic SAML Application
SAML_IDP_ENTITY_ID=https://sso-dbbfec7f.sso.duosecurity.com/saml2/sp/DIVD4SFEKUOFYSOE9EDE/metadata
SAML_IDP_SSO_URL=https://sso-dbbfec7f.sso.duosecurity.com/saml2/sp/DIVD4SFEKUOFYSOE9EDE/sso
SAML_IDP_

# Things SSO Integration (things.cisco.com)
# Register your tool at things.cisco.com to get these values
THINGS_BASE_URL=https://things.cisco.com
THINGS_TOOL_SLUG=vyper
THINGS_API_TOKEN=things_6632dcb61f29bf17d9afbfc27135a6c06f83b9a315ab4503bab3077b6e3aa8e8
THINGS_UNSEAL_KEY=unseal_7e27533eaaee5788926cbb3f7834e1b818399ae612d7481d03a906e80f25d1a2
# Username that can manage HTTPS certificates in Settings (defaults to "aleroyds")
# THINGS_ADMIN_USERNAME=aleroyds
# Optional: Override auto-detected server IP for certificate CN and SSO redirects
# THINGS_CERT_CN=10.196.150.41

# AWS Bedrock for Claude models (required for AI Chat with Claude provider)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_BEDROCK_REGION=us-east-2
